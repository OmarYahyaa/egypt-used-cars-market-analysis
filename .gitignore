# Raw/local dataset files
# Keep source data outside Git unless a small sample is intentionally added.
data/**/*.csv
data/**/*.zip
data/**/*.xlsx
data/**/*.xls

# Database exports and backups
*.backup
*.dump
*.sql.gz
*.bak

# Environment and local configuration
.env
.env.*
*.local

# Python / notebook temporary files
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Editor / OS files
.vscode/
.idea/
*.tmp
*.log
.DS_Store
Thumbs.db

# Office temporary files
~$*
